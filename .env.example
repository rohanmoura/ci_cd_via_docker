# Runtime
NODE_ENV=development

# Public application ports
WEB_PORT=3000
HTTP_SERVER_PORT=3001
WS_SERVER_PORT=3002
WS_INTERNAL_EVENT_URL=http://localhost:3002/events
WS_INTERNAL_TOKEN=local-development-token

# Browser-facing URLs
NEXT_PUBLIC_HTTP_SERVER_URL=http://localhost:3001
NEXT_PUBLIC_WS_SERVER_URL=ws://localhost:3002

# Allowed browser origin for backend services
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (used from Phase 6 onward)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgresql://app:app@localhost:5432/app
